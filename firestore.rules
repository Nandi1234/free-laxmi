rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isAdmin() { return signedIn() && myProfile().role == 'admin'; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isAdmin() || isSelf(uid);
      // Admin can manage profile docs; users cannot promote themselves.
      allow create, update, delete: if isAdmin();
    }
    match /dealers/{dealerId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }
    match /attendance/{recordId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId','checkIn','status']);
      allow update: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid
        && !('checkOut' in resource.data) && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['checkOut','checkOutLat','checkOutLng','status']));
      allow delete: if isAdmin();
    }
    match /visits/{visitId} {
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasAll(['userId','dealerId','photoUrl','photoPath','employeeLat','employeeLng','createdAt']);
      allow update, delete: if isAdmin();
    }
  }
}